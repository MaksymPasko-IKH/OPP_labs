import unittest
from unittest.mock import MagicMock

class TestUserManager(unittest.TestCase):

    def test_notify_user(self):
        mock_service = MagicMock()

        manager = UserManager(mock_service)

        manager.notify_user("Maxim", "Вітаємо!")

        mock_service.send.assert_called_once_with("Maxim", "Вітаємо!")

class NotificationService:

    def send(self, user, message):
        print(f"Повідомлення для {user}: {message}")


class UserManager:

    def __init__(self, notification_service):
        self.notification_service = notification_service

    def notify_user(self, user, message):
        self.notification_service.send(user, message)

