import unittest

class TestLibraryItem(unittest.TestCase):

    def test_details(self):
        book = LibraryItem("Кобзар", "Тарас Шевченко", 1840)
        self.assertEqual(
            book.details(),
            "Назва: Кобзар, Автор: Тарас Шевченко, Рік: 1840"
        )

    def test_details_second_example(self):
        book = LibraryItem("1984", "George Orwell", 1949)
        self.assertEqual(
            book.details(),
            "Назва: 1984, Автор: George Orwell, Рік: 1949"
        )

class LibraryItem:

    def __init__(self, title, author, year):
        self.title = title
        self.author = author
        self.year = year

    def details(self):
        return f"Назва: {self.title}, Автор: {self.author}, Рік: {self.year}"

