import statistics

class StatsTracker:
    def __init__(self):
        self.numbers = []

    def add(self, value):
        self.numbers.append(value)

    def mean(self):
        return statistics.mean(self.numbers)

    def median(self):
        return statistics.median(self.numbers)

    def mode(self):
        return statistics.mode(self.numbers)


# Приклад роботи
stats = StatsTracker()

stats.add(2)
stats.add(3)
stats.add(2)

print(stats.mean())    # 2.33 середнє значення
print(stats.median())  # 2 медіан
print(stats.mode())    # 2 моду

