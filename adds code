import statistics

class StatsTracker:
    def __init__(self):
        self.numbers = []

    def add(self, value):
        self.numbers.append(value)

    def mean(self):
        return statistics.mean(self.numbers)

    def median(self):
        return statistics.median(self.numbers)

    def mode(self):
        return statistics.mode(self.numbers)


