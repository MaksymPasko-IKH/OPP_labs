class Graph:
    def __init__(self):
        self.graph = {}

    def add_edge(self, a, b):
        if a not in self.graph:
            self.graph[a] = []
        self.graph[a].append(b)

    def neighbors(self, node):
        return self.graph.get(node, [])


g = Graph()
g.add_edge("A", "B")

print(g.neighbors("A"))  # Output: ['B']
