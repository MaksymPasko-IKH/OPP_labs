class FactorialCache:
    def __init__(self):
        self.cache = {}

    def compute(self, n):
        if n in self.cache:
            return self.cache[n]

        if n == 0 or n == 1:
            result = 1
        else:
            result = n * self.compute(n - 1)

        self.cache[n] = result
        return result


fc = FactorialCache()

print(fc.compute(5))  # Output: 120

