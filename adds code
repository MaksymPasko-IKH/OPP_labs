from abc import ABC, abstractmethod

class Game(ABC):

    @abstractmethod
    def play(self):
        pass


class Chess(Game):
    def play(self):
        print("Playing Chess")


class TicTacToe(Game):
    def play(self):
        print("Playing TicTacToe")


# Приклад роботи
