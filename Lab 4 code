import pandas as pd
import sqlite3
#2
class DatabaseManager:

    def __init__(self, db_name="jobs.db"):
        self.conn = sqlite3.connect(db_name)
        self.cursor = self.conn.cursor()

    def close_connection(self):
        self.conn.close()
#3
class DataPreparation:

    def __init__(self, db_manager):
        self.db = db_manager

    def load_csv(self, file_path):
        self.df = pd.read_csv(file_path)

        print("Дані успішно завантажені")
        print(self.df.head())

        # очищаємо Salary Range
        self.df["Salary Range"] = self.df["Salary Range"].str.replace("£", "")
        self.df["Salary Range"] = self.df["Salary Range"].str.replace(",", "")

        # розділяємо мін і макс зарплату
        salary_split = self.df["Salary Range"].str.split("-", expand=True)

        self.df["Salary Min"] = salary_split[0].astype(int)
        self.df["Salary Max"] = salary_split[1].astype(int)

        # середня зарплата
        self.df["Salary"] = (self.df["Salary Min"] + self.df["Salary Max"]) / 2

        return self.df

    def save_to_db(self):
        self.df.to_sql("jobs", self.db.conn, if_exists="replace", index=False)
        print("Дані записані в таблицю jobs")
