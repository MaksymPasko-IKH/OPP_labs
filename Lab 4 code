class JobQueries:

    def __init__(self, db_manager):
        self.db = db_manager

    def first_10_jobs(self):
        query = "SELECT * FROM jobs LIMIT 10"
        result = pd.read_sql(query, self.db.conn)
        print("\nПерші 10 вакансій:")
        print(result)

    def jobs_with_sql_skill(self):
        query = """
        SELECT * FROM jobs
        WHERE `Required Skills` LIKE '%SQL%'
        """
        result = pd.read_sql(query, self.db.conn)
        print("\nВакансії з SQL:")
        print(result)

    def unique_locations_companies(self):
        query = """
        SELECT DISTINCT Location, Company
        FROM jobs
        """
        result = pd.read_sql(query, self.db.conn)
        print("\nУнікальні Location та Company:")
        print(result)
#5
class AnalyticsQueries:

    def __init__(self, db_manager):
        self.db = db_manager

    def average_salary_by_experience(self):
        query = """
        SELECT `Experience Level`,
        AVG(`Salary`) as avg_salary
        FROM jobs
        GROUP BY `Experience Level`
        """
        result = pd.read_sql(query, self.db.conn)
        print("\nСередня зарплата за рівнем досвіду:")
        print(result)

    def jobs_count_by_experience(self):
        query = """
        SELECT `Experience Level`,
        COUNT(*) as jobs_count
        FROM jobs
        GROUP BY `Experience Level`
        """
        result = pd.read_sql(query, self.db.conn)
        print("\nКількість вакансій за рівнем досвіду:")
        print(result)

    def min_max_salary(self):
        query = """
        SELECT
        MIN(Salary) as min_salary,
        MAX(Salary) as max_salary
        FROM jobs
        """
        result = pd.read_sql(query, self.db.conn)
        print("\nМінімальна та максимальна зарплата:")
        print(result)
