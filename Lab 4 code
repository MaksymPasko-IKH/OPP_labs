class AggregateQueries:

    def __init__(self, db_manager):
        self.db = db_manager

    def jobs_by_industry_high_salary(self):
        query = """
        SELECT Industry, COUNT(*) as jobs_count
        FROM jobs
        WHERE Salary > 50000
        GROUP BY Industry
        """
        result = pd.read_sql(query, self.db.conn)
        print("\nКількість вакансій в індустріях із зарплатою > 50000:")
        print(result)

    def avg_salary_by_industry(self):
        query = """
        SELECT Industry,
        AVG(Salary) as avg_salary
        FROM jobs
        GROUP BY Industry
        """
        result = pd.read_sql(query, self.db.conn)
        print("\nСередня зарплата по індустріях:")
        print(result)
