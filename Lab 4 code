class ExtraQueries:

    def __init__(self, db):
        self.db = db

    # 1. 5 вакансій з найбільшою максимальною зарплатою
    def top5_highest_salary(self):
        query = """
        SELECT `Job Title`, `Company`, `Salary Max`
        FROM jobs
        ORDER BY `Salary Max` DESC
        LIMIT 5
        """
        result = pd.read_sql(query, self.db.conn)
        print("\n5 вакансій з найвищою зарплатою:")
        print(result)


    # 2. Кількість вакансій по Required Skills
    def skills_count(self):
        df = pd.read_sql("SELECT `Required Skills` FROM jobs", self.db.conn)

        skills = df["Required Skills"].str.split(",", expand=True).stack()
        skills = skills.str.strip()

        result = skills.value_counts()

        print("\nКількість вакансій за навичками:")
        print(result)


    # 3. Компанії з найбільшою кількістю вакансій у 2023 році
    def top_companies_2023(self):
        query = """
        SELECT Company, COUNT(*) as jobs_count
        FROM jobs
        WHERE `Date Posted` LIKE '%2023'
        GROUP BY Company
        ORDER BY jobs_count DESC
        LIMIT 10
        """

        result = pd.read_sql(query, self.db.conn)

        print("\nКомпанії з найбільшою кількістю вакансій у 2023:")
        print(result)
